{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main eStock Manager window (all platforms)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://wa.me/*" },
        { "url": "mailto:*" },
        { "url": "rawbt:*" },
        { "url": "https://play.google.com/*" },
        { "url": "https://github.com/treasure155/estock-manager/*" }
      ]
    }
  ]
}
